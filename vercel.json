{
  "framework": null,
  "buildCommand": "node scripts/prepare-public.js",
  "outputDirectory": "public",
  "functions": { "api/index.js": { "includeFiles": "database.sql" } },
  "redirects": [
    { "source": "/", "destination": "/user/", "permanent": false },
    { "source": "/admin", "destination": "/admin/dashboard.html", "permanent": false },
    { "source": "/admin/", "destination": "/admin/dashboard.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/login", "destination": "/login/index.html" },
    { "source": "/favicon.ico", "destination": "/favicon.png" }
  ]
}
